rules_version = '2';

// DocFacil — Firestore Security Rules
// Deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // === Users ===
    // Cada usuário só lê o próprio perfil.
    // Pode atualizar dados normais via whitelist explícita de campos seguros.
    match /users/{uid} {
      function onlyEditableProfileFields() {
        return request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['nome', 'telefone', 'fotoUrl', 'atualizadoEm']);
      }

      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && (!request.resource.data.keys().hasAny(['plano']) || request.resource.data.plano == 'gratis');
      allow update: if request.auth != null
        && request.auth.uid == uid
        && onlyEditableProfileFields();
      allow delete: if false;
    }

    // === Models (catálogo de documentos) ===
    // Leitura pública. Escrita somente via Admin SDK.
    match /models/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // === Documents (documentos gerados) ===
    // Leitura permitida para o proprietário autenticado.
    // TODAS as mutações (criação, edição, exclusão) são estritamente bloqueadas no client
    // e coordenadas exclusivamente pelo backend via Firebase Admin SDK.
    match /documents/{id} {
      allow read: if request.auth != null && (
        (resource.data.owner.type == 'user' && resource.data.owner.userId == request.auth.uid) ||
        resource.data.userId == request.auth.uid
      );
      allow write: if false;

      match /artifacts/{version} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/documents/$(id)).data.owner.userId == request.auth.uid ||
          get(/databases/$(database)/documents/documents/$(id)).data.userId == request.auth.uid
        );
        allow write: if false;
      }
    }

    // === Access Links (tokens de magic link e compartilhamento) ===
    // Bloqueio total no client. Acesso exclusivamente server-side via hash.
    match /access_links/{tokenHash} {
      allow read, write: if false;
    }

    // === Orders (pedidos de pagamento) ===
    // Leitura pelo comprador autenticado. Escrita exclusivamente server-side.
    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.buyer.userId == request.auth.uid;
      allow write: if false;
    }

    // === Generation Requests (idempotência e travas) ===
    // Bloqueio total no client.
    match /generation_requests/{requestId} {
      allow read, write: if false;
    }

    // === Payments (legado) ===
    match /payments/{id} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // === Consents (aceites de termos e privacidade) ===
    // O cliente só pode registrar e consultar o próprio aceite depois de
    // autenticar. O registro é imutável para preservar a evidência original.
    match /consents/{consentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'userId', 'documents', 'termsVersion', 'flow', 'acceptedAt', 'userAgent', 'termsHash'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'userEmail', 'documents', 'termsVersion', 'flow', 'acceptedAt',
          'ipAddress', 'userAgent', 'termsHash'
        ])
        && (!request.resource.data.keys().hasAny(['userEmail'])
          || request.resource.data.userEmail == request.auth.token.email);
      allow update, delete: if false;
    }
  }
}
