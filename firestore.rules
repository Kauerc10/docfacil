rules_version = '2';

// DocFacil — Firestore Security Rules
// Deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // === Users ===
    match /users/{uid} {
      function onlyEditableProfileFields() {
        return request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['nome', 'telefone', 'fotoUrl', 'atualizadoEm']);
      }

      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && (!request.resource.data.keys().hasAny(['plano']) || request.resource.data.plano == 'gratis');
      allow update: if request.auth != null
        && request.auth.uid == uid
        && onlyEditableProfileFields();
      allow delete: if false;
    }

    // === Models ===
    match /models/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // === Documents ===
    match /documents/{id} {
      allow read: if request.auth != null && (
        (resource.data.owner.type == 'user' && resource.data.owner.userId == request.auth.uid) ||
        resource.data.userId == request.auth.uid
      );
      allow write: if false;

      match /artifacts/{version} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/documents/$(id)).data.owner.userId == request.auth.uid ||
          get(/databases/$(database)/documents/documents/$(id)).data.userId == request.auth.uid
        );
        allow write: if false;
      }
    }

    // === Account Drafts ===
    // Rascunhos autenticados passam exclusivamente pelas API routes, que
    // validam ownership usando Firebase Admin SDK. O client nunca acessa a
    // coleção diretamente, inclusive para evitar falsificação de ownerUserId.
    match /drafts/{draftId} {
      allow read, write: if false;
    }

    // === Access Links ===
    match /access_links/{tokenHash} {
      allow read, write: if false;
    }

    // === Orders ===
    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.buyer.userId == request.auth.uid;
      allow write: if false;
    }

    // === Generation Requests ===
    match /generation_requests/{requestId} {
      allow read, write: if false;
    }

    // === Payments (legado) ===
    match /payments/{id} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // === Consents ===
    match /consents/{consentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }
  }
}
