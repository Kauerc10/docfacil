# ──────────────────────────────────────────────────────────────────────────────
# DocFacil — Variáveis de ambiente (EXEMPLO)
#
# Copie este arquivo para .env e preencha com seus valores:
#   cp .env.example .env
#
# NUNCA commite o .env real — ele está no .gitignore.
# Em produção, use os secrets do seu provedor (Vercel, Railway, etc.).
# ──────────────────────────────────────────────────────────────────────────────

# ── Banco de Dados (legacy — Prisma/SQLite, mantido para migrações) ──────────
# Desenvolvimento (SQLite local):
DATABASE_URL="file:./db/custom.db"

# ── Firebase (Auth + Firestore) ──────────────────────────────────────────────
# Configure um projeto em https://console.firebase.google.com
# Project Settings → "Your apps" → Web app → copie o config.
#
# IMPORTANTE: sem estas variáveis o app roda em "demo mode" (dados locais +
# localStorage). Com elas preenchidas, autenticação e Firestore ficam ativos.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="seu-projeto"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ── IA (z-ai-web-dev-sdk) ────────────────────────────────────────────────────
# Chave para o Gerador com IA (LLM, VLM, TTS, ASR, image-generation)
ZAI_API_KEY="sua-chave-zai-aqui"

# ── App ───────────────────────────────────────────────────────────────────────
# Ambiente: development | production
NODE_ENV="development"
# Porta do servidor de desenvolvimento
PORT=3000

# ── K-HUB / Comercial ────────────────────────────────────────────────────────
# As informações da empresa (nome, WhatsApp, site) ficam em src/lib/company.ts
# e NÃO aqui — são parte do código (identidade de marca), não configuração.
