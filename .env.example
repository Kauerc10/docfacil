# ──────────────────────────────────────────────────────────────────────────────
# DocFacil — Variáveis de ambiente (EXEMPLO)
#
# Copie este arquivo para .env e preencha com seus valores:
#   cp .env.example .env
#
# NUNCA commite o .env real — ele está no .gitignore.
# Em produção, use os secrets do seu provedor (Vercel, Railway, etc.).
# ──────────────────────────────────────────────────────────────────────────────

# ── Banco de Dados ───────────────────────────────────────────────────────────
# Desenvolvimento (SQLite local):
DATABASE_URL="file:./db/custom.db"
# Produção (PostgreSQL/MySQL — recomenda-se Pool):
# DATABASE_URL="postgresql://user:password@localhost:5432/docfacil?schema=public"

# ── Autenticação (NextAuth.js v4) ────────────────────────────────────────────
# Gere uma chave aleatória: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-uma-chave-aleatoria-forte"
# URL base do app (sem barra no final)
NEXTAUTH_URL="http://localhost:3000"

# ── IA (z-ai-web-dev-sdk) ────────────────────────────────────────────────────
# Chave para o Gerador com IA (LLM, VLM, TTS, ASR, image-generation)
ZAI_API_KEY="sua-chave-zai-aqui"

# ── App ───────────────────────────────────────────────────────────────────────
# Ambiente: development | production
NODE_ENV="development"
# Porta do servidor de desenvolvimento
PORT=3000

# ── K-HUB / Comercial ────────────────────────────────────────────────────────
# As informações da empresa (nome, WhatsApp, site) ficam em src/lib/company.ts
# e NÃO aqui — são parte do código (identidade de marca), não configuração.
