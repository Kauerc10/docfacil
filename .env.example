# ──────────────────────────────────────────────────────────────────────────────
# DocFacil — Variáveis de ambiente (EXEMPLO)
#
# Copie este arquivo para .env e preencha com seus valores:
#   cp .env.example .env
#
# NUNCA commite o .env real — ele está no .gitignore.
# Em produção, use os secrets do seu provedor (Vercel, Railway, etc.).
# ──────────────────────────────────────────────────────────────────────────────

# ── Banco de Dados (legacy — Prisma/SQLite, mantido para migrações) ──────────
DATABASE_URL="file:./db/custom.db"

# ── Firebase Client (Auth + Firestore Web SDK) ──────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="seu-projeto"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ── Firebase Admin Server-Side (NUNCA usar prefixo NEXT_PUBLIC_) ─────────────
# Credenciais da conta de serviço (Project Settings → Service Accounts)
FIREBASE_PROJECT_ID="seu-projeto"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# ── Cloudflare R2 (Armazenamento Privado de PDFs) ─────────────────────────────
# S3 API credentials com permissão Object Read & Write scoped ao bucket
R2_ACCOUNT_ID="seu-cloudflare-account-id"
R2_ACCESS_KEY_ID="sua-r2-access-key-id"
R2_SECRET_ACCESS_KEY="sua-r2-secret-access-key"
R2_BUCKET_NAME="docfacil-pdfs-prod"

# ── Firebase App Check (Proteção de Endpoints) ────────────────────────────────
# Ativa verificação estrita em produção (false em dev local/test/preview)
APP_CHECK_ENFORCED="false"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""

# ── Billing / Pagamentos / Storage ───────────────────────────────────────────
# ALLOW_DEMO_BILLING só deve ser "true" em development ou preview tests
ALLOW_DEMO_BILLING="true"
# ALLOW_IN_MEMORY_ARTIFACT_STORAGE só deve ser "true" em dev sem credenciais R2
ALLOW_IN_MEMORY_ARTIFACT_STORAGE="false"

# Migração: manter abacatepay até os fluxos Mercado Pago estarem validados.
CHECKOUT_PROVIDER="abacatepay"
# Não habilitar modo demonstrativo em produção.
NEXT_PUBLIC_CHECKOUT_PROVIDER="abacatepay"
# Configurar estes valores apenas no servidor; nunca enviar ao navegador.
# MERCADOPAGO_ACCESS_TOKEN=""
# MERCADOPAGO_WEBHOOK_SECRET=""
# MERCADOPAGO_COLLECTOR_ID=""
MERCADOPAGO_ENVIRONMENT="test"
# Permanecer false até comprovar desconto, renovação e expiração externos.
MERCADOPAGO_PROMOTION_VERIFIED="false"
# Recuperação de compras e e-mail transacional: valores apenas no servidor.
# BILLING_RECONCILE_SECRET="gere-um-segredo-aleatorio-de-32-ou-mais-caracteres"
# PURCHASE_ACCESS_SECRET="outro-segredo-aleatorio-de-32-ou-mais-caracteres"
# PURCHASE_MAIL_API_KEY=""
# PURCHASE_MAIL_FROM="Compras <compras@seu-dominio.com>"

# ── IA (z-ai-web-dev-sdk) ────────────────────────────────────────────────────
ZAI_API_KEY="sua-chave-zai-aqui"

# ── App & URLs ────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
